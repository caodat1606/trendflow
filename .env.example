# Copy to .env and edit if needed. Nothing here is required.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Optional vision models tried in order (only if installed): qwen2.5vl:7b,qwen3-vl:8b,qwen3-vl:4b
# VISION_MODELS=qwen2.5vl:7b
# Wikimedia asks API users to identify themselves; this only goes into the User-Agent header.
# CONTACT_EMAIL=you@example.com
# Faster hardware encoder on Apple Silicon (slightly larger files): videotoolbox
# VIDEO_ENCODER=libx264
AUTO_SCAN=true
SCAN_INTERVAL_MINUTES=30
# Azure Speech (same Nam Minh voice, official Microsoft API; free tier F0 = 500,000 characters/month).
# You can also paste the key in TrendFlow > Cài đặt instead of here.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southeastasia
# Gemini TTS (Google AI Studio key) — a different, natural voice (not Nam Minh).
# GEMINI_API_KEY=
